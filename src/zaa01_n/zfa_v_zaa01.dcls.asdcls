@EndUserText.label: 'Access control for view of ZAA01'
@MappingRole: true
define role ZFA_V_ZAA01 {
    grant
        select
            on
                ZFA_V_ZAA01
                    where
                        ( CompanyCode ) = aspect pfcg_auth( F_BKPF_BUK, BUKRS, ACTVT = '03');
                        
}