managed implementation in class ZBP_R_TBFI_LOG_KC unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_TBFI_LOG_KC alias ZrTbfiLogKc
persistent table ZTB_FI_LOG_KC
extensible
draft table ZTBFI_LOG_KC_D
etag master LocalLastChangedAt
lock master total etag LocalLastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   Rulty,
   Lineid,
   Bukrs,
   Fiscalyear,
   Period,
   Accountingdocumenttype,
   Documentdate,
   Postingdate,
   Accountingdocumentheadertext,
   Isreversed;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedBy,
   LocalLastChangedAt;

  field ( readonly : update )
   Rulty,
   Lineid,
   Bukrs,
   Fiscalyear,
   Period,
   Accountingdocumenttype,
   Documentdate,
   Postingdate,
   Accountingdocumentheadertext,
   Isreversed;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZTB_FI_LOG_KC corresponding extensible
  {
    Rulty = rulty;
    Lineid = lineid;
    Bukrs = bukrs;
    Fiscalyear = fiscalyear;
    Period = period;
    Accountingdocumenttype = accountingdocumenttype;
    Documentdate = documentdate;
    Postingdate = postingdate;
    Accountingdocumentheadertext = accountingdocumentheadertext;
    Isreversed = isreversed;
    Sacct = sacct;
    Dacct = dacct;
    Dcost = dcost;
    Oacct = oacct;
    Ocost = ocost;
    Waers = waers;
    Amount = amount;
    Belnr = belnr;
    Gjahr = gjahr;
    BelnrR = belnr_r;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
  }

}