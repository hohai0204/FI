  presentationVariant: [{
    sortOrder: [
      { by: 'GLAccount',  direction: #ASC }
    ],

    visualizations: [{ type: #AS_LINEITEM }]
  }]

}
annotate entity zfa_i_zrm02_exc_lines with
{

