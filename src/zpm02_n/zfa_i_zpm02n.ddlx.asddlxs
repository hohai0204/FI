@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName: 'Sổ tổng hợp công nợ phải trả NCC',
                typeNamePlural: 'Sổ tổng hợp công nợ phải trả NCC',
                title: { type: #STANDARD, label: 'GLAccount', value: 'GLAccount' } },
/* Presentation Variant */
  presentationVariant: [{
    sortOrder: [
      { by: 'GLAccount',  direction: #ASC },
      { by: 'PostingDate',  direction: #ASC }
    ],

    visualizations: [{ type: #AS_LINEITEM }]
  }]

}
annotate entity ZFA_I_ZPM02N with
{

  @EndUserText.label: 'Mã công ty'
  @UI.facet: [ { label: 'General Information',
                 id: 'GeneralInfo',
                 purpose: #STANDARD,
                 position: 10 ,
                 type: #IDENTIFICATION_REFERENCE }
                ,{ id:            'Items',
                 purpose:         #STANDARD,
                 type:            #LINEITEM_REFERENCE,
                 label:           'Items',
                 position:        20,
                 targetElement:   '_ItemsZPM02'}
              ]
  @UI: {
  identification: [ { position: 10 }],
  selectionField: [ { position: 10 } ],
  lineItem: [ { position: 10 }]
  }
  @Consumption.filter: {
      multipleSelections: false,
      mandatory: true,
      selectionType: #SINGLE,
      defaultValue: '1100'
  }
  CompanyCode;

  @EndUserText.label: 'Năm tài chính'
  @UI: {
  identification: [ { position: 20 } ],
  selectionField: [ { position: 20 } ]
  //  lineItem: [ { position: 20 } ]
  }
  @Consumption.filter: {
  multipleSelections: false,
  mandatory: true,
  selectionType: #SINGLE,
  defaultValue: '2025'
  }
