  headerInfo: {
    typeName: 'VAT Report',
    typeNamePlural: 'VAT Reports',
    title: { type: #STANDARD, value: 'AccountingDocument' }
  }
}
annotate view ZFA_Q_ZPM03_AT_QUERY with {

