      useForValidation: true,
      additionalBinding: [{ localElement: 'FsVersion' , element: 'GLAccountHierarchy' , usage: #FILTER_AND_RESULT }]
   }]
  FinancialStatement;
  @EndUserText.label: 'Hierarchy Node Text'
  @UI.identification: [ {
