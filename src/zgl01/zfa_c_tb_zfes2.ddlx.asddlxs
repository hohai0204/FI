    label: 'General Information',
    id: 'GeneralInfo',
    purpose: #STANDARD,
    position: 10 ,
    type: #IDENTIFICATION_REFERENCE
  } ]

  @UI.hidden: true
  Uuid;

  @EndUserText.label: 'FS Version'
  @UI.identification: [ {
    position: 20
  } ]
  @UI.lineItem: [ {
    position: 20
  } ]
  @UI.selectionField: [ {
    position: 20
  } ]
  @Consumption.valueHelpDefinition: [{
  qualifier: '',
      entity: {
          name: 'I_GLAccountHierarchy',
          element: 'GLAccountHierarchy'
      },
      distinctValues: true,
      useForValidation: true

   }]
  FsVersion;

  @EndUserText.label: 'Financial Statement'
  @UI.identification: [ {
    position: 30
  } ]
