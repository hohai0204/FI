@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName: 'Bảng cân đối số phát sinh',
    typeNamePlural: 'Bảng cân đối số phát sinh'
  }
}
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'keysubtotal'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'keysubtotal'
annotate entity ZFA_R_ZGL02_EX with
{
  @UI.lineItem: [{ position: 10 }]
  @EndUserText.label: 'Tài khoản'
  keysubtotal;
  //    glaccount;
  //    uuid;
  @UI.lineItem: [{ position: 20 }]
  @EndUserText.label: 'Mô tả tài khoản'
  //    companycode;
  account_text;
  //    fiscalyear;
  //    fiscalperiod;
  //    display_subtotal;
  @UI.lineItem: [{ position: 30 }]
  @EndUserText.label: 'Đầu kỳ Nợ'
  dauky_no;
  @UI.lineItem: [{ position: 40 }]
  @EndUserText.label: 'Đầu kỳ Có'
  dauky_co;

  @UI.lineItem: [{ position: 50 }]
  @EndUserText.label: 'Phát sinh Nợ'
  phatsinh_no;
  @UI.lineItem: [{ position: 60 }]
  @EndUserText.label: 'Phát sinh Có'
  phatsinh_co;
  @UI.lineItem: [{ position: 70 }]
  @EndUserText.label: 'Cuối kỳ Nợ'
  cuoiky_no;
  @UI.lineItem: [{ position: 80 }]
  @EndUserText.label: 'Cuối kỳ Có'
  cuoiky_co;

  @UI.selectionField: [{ position: 10 }]
  @EndUserText.label: 'GL Account'
  @Consumption.valueHelpDefinition: [
  { entity:  { name:    'I_GLAccount',
         element: 'GLAccount' }
  }]
  glaccount;
  @UI.selectionField: [{ position: 20 }]
  @EndUserText.label: 'Company Code'
  @Consumption.filter.mandatory: true
  @UI.lineItem: [{ position: 10 }]
  companycode;
  @UI.selectionField: [{ position: 30 }]
  @EndUserText.label: 'Fiscal Year'
  @Consumption.filter.mandatory: true
  
  fiscalyear;
  @UI.selectionField: [{ position: 40 }]
  @EndUserText.label: 'Fiscal Period'
  @Consumption.filter.mandatory: true
  
  fiscalperiod;
  @UI.selectionField: [{ position: 50 }]
  @EndUserText.label: 'Display Subtotal'
  @Consumption.filter.mandatory: true
  @Consumption.valueHelpDefinition: [
  { entity:  { name:    'ZFA_I_DISPLAY_SUBTOTAL',
           element: 'value_low' }
  }]
  display_subtotal;
