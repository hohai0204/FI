managed implementation in class zbp_fa_r_zgl07 unique;
strict ( 2 );

define behavior for ZFA_R_ZGL07 alias ZGL07
persistent table ztb_fi_pdf_draf
lock master
authorization master ( instance )
//etag master <field_name>
{
  create;
  update;
  delete;
  field ( readonly ) CompanyCode, FiscalYear, JournalEntry;
  action ( features : instance ) PrintPDF parameter ZA_FA_ZGL07 result [0..*] $self;
}