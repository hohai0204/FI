@EndUserText.label: 'Access control for view of ZGL07'
@MappingRole: true
define role ZFA_R_ZGL07 {
    grant
        select
            on
                ZFA_R_ZGL07
                    where
                        ( CompanyCode ) = aspect pfcg_auth( F_BKPF_BUK, BUKRS, ACTVT = '03');
                        
} 