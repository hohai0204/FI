managed implementation in class zbp_r_fa_zpm01 unique;
strict ( 2 );

define behavior for ZR_FA_ZPM01 //alias <alias_name>
persistent table ztb_fi_pdf_draf
lock master
authorization master ( instance )
{
  create;
  update;
  delete;

  action ( features : instance ) PrintPDF parameter zst_print_zpm01 result [1] $self;

  //  mapping for ztb_fi_pdf_draf
