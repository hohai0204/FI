  @UI.lineItem:       [ { position: 70, label: 'Mã Vendor/Customer' } ]
  OffsettingAccount;

  @EndUserText.label: 'Tên Vendor/Customer'
  @UI.identification: [ { position: 80 , label: 'Tên Vendor/Customer' } ]
