@Metadata.layer: #CORE
@UI: {
  createHidden: true,
  deleteHidden: true,
  updateHidden: true,

  headerInfo: {
    typeName: 'Chứng từ',
    typeNamePlural: 'Sổ quỹ tiền mặt',
    title: { type: #STANDARD, value: 'AccountingDocument' },
    description: { type: #STANDARD, value: 'GLAccount' }
  },

  presentationVariant: [ {
    sortOrder: [
      { by: 'GLAccountText',  direction: #ASC },
      { by: 'PostingDate',  direction: #ASC },
      { by: 'AccountingDocument',  direction: #ASC }
    ],
    visualizations: [ { type: #AS_LINEITEM } ]
  } ]
}
annotate entity ZI_FA_ZGL05_EX with
{

  @UI.facet: [ {
    label: 'General Information',
    id: 'GeneralInfo',
    purpose: #STANDARD,
    position: 10 ,
    type: #IDENTIFICATION_REFERENCE
  } ]

  @EndUserText.label: 'Company Code'
  @UI.identification: [ { position: 10 , label: 'Company Code' } ]
   @UI.selectionField: [ {
    position: 10
  } ]
  @Consumption.filter: {
    multipleSelections: false,
    mandatory: true,
    selectionType: #SINGLE,
    defaultValue: '1100'
  }
  CompanyCode;

  @EndUserText.label: 'Fiscal Year'
  @UI.identification: [ { position: 11 , label: 'Fiscal Year' } ]
  @UI.selectionField: [ { position: 11 } ]
  @Consumption.filter: {
    multipleSelections: false,
    mandatory: true,
    selectionType: #SINGLE,
    defaultValue: '2025'
  }
  FiscalYear;

  @EndUserText.label: 'GL Acount'
  @UI.identification: [ { position: 20 , label: 'GL Acount' } ]
  @UI.selectionField: [ { position: 13 } ]
  GLAccount;
  
    @EndUserText.label: 'Hiển thị cặp chứng từ huỷ'
  @UI.selectionField: [ {
    position: 15
  } ]
  @Consumption.filter: {
  //    multipleSelections: false,
  //    mandatory: false,
  //    selectionType: #SINGLE,
    defaultValue: 'X'
  }
  IsIncludeReversal;
  
 @EndUserText.label: 'Accounting Document' 
  @UI.identification: [ { position: 10 } ]
  @UI.lineItem:       [ { position: 10, label: 'Thông tin Vendor/Customer' } ]
  Des;
  
  @EndUserText.label: 'Posting Date'
  @UI.identification: [ { position: 20 , label: 'Ngày ghi sổ' } ]
  @UI.selectionField: [ { position: 12 } ]
  @Consumption.filter: {
    multipleSelections: false,
    mandatory: true,
    selectionType: #INTERVAL
  }
  @UI.lineItem:       [ { position: 20, label: 'Ngày ghi sổ' } ]
  PostingDate;
 
  @EndUserText.label: 'Document Date'
  @UI.identification: [ { position: 30 , label: 'Ngày chứng từ' } ]
  @UI.lineItem:       [ { position: 30, label: 'Ngày chứng từ' } ]
  DocumentDate;

  @EndUserText.label: 'Accounting Document'
  @UI.identification: [ { position: 40 , label: 'Số chứng từ' } ]
  @UI.lineItem:       [ { position: 40, label: 'Số chứng từ' } ]
  AccountingDocument;
  
  @EndUserText.label: 'Diễn giải'
  @UI.identification: [ { position: 50 , label: 'Diễn giải' } ]
  @UI.lineItem:       [ { position: 50, label: 'Diễn giải' } ]
  DocumentItemText;

  @EndUserText.label: 'Journal entry type'
  @UI.identification: [ { position: 60 , label: 'Loại bút toán' } ]
  @UI.lineItem:       [ { position: 60, label: 'Loại bút toán' } ]
