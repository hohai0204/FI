  @EndUserText.label: 'Tài khoản đối ứng'
  @UI.identification: [ { position: 90 , label: 'Tài khoản đối ứng' } ]
  @UI.lineItem:       [ { position: 90, label: 'Tài khoản đối ứng' } ]
  ReconciliationAccount;

  @EndUserText.label: 'Debit/Credit Code'
